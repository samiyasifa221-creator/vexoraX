rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Global Default-Deny Catch-All (Pillar 1)
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Hardened Global Helpers (Pillars 2, 3)
    // -------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin authorization backed by trusted database document lookup (Pillar 3)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // -------------------------------------------------------------
    // User Public Profile
    // -------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName'])
        && data.keys().hasOnly(['userId', 'displayName', 'avatarUrl', 'online', 'lastSeen'])
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('online' in data) || data.online is bool);
    }

    match /users/{userId}/public/profile {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'online', 'lastSeen']);
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // User Private Information (Pillar 6: PII & Balance Isolation)
    // Client write is strictly blocked for balance, risk, premium, suspension.
    // -------------------------------------------------------------
    match /users/{userId}/private/info {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Blanket queries forbidden
      // Private info (points balance, coins, risk, suspension) can ONLY be written by backend/admin
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Points Transactions Ledger (Section 31 & 32)
    // Server-Authoritative Ledger: Direct client writes are FORBIDDEN!
    // -------------------------------------------------------------
    match /points_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.user_id == request.auth.uid || isAdmin());
      // Secure list query: client must filter by user_id == request.auth.uid
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      // Clients NEVER directly insert, update or delete ledger transactions
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // Task Sessions (Section 30)
    // Generated and verified strictly server-side
    // -------------------------------------------------------------
    match /task_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Client cannot forge or update task sessions directly
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // Campaigns & Announcements (Read by clients, written by Admins)
    // -------------------------------------------------------------
    match /campaigns/{campaignId} {
      allow get, list: if isSignedIn() && isValidId(campaignId);
      // Clients cannot modify campaign budgets, rewards, or completion status
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if isSignedIn() && isValidId(announcementId);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Admin Records Collection
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if false; // Only accessible via Admin SDK
    }
  }
}
