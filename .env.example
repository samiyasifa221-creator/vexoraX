# ==============================================================================
# VexoraX Android & Full-Stack Environment Variables
# ==============================================================================

# Server-Side Configuration (Never expose secrets to client/Android bundles)
PORT=3000
NODE_ENV=development

# GEMINI_API_KEY: Server-side Gemini AI API key.
# In AI Studio this is automatically injected via the Secrets panel.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: Production or hosted backend URL.
# Android apps connecting remotely use this endpoint.
APP_URL=https://your-vexorax-backend.run.app

# Client-Side Base URL for Android App Build:
# When packaged as a native Android APK, requests point to your remote backend.
# For Android Studio Emulator connecting to local host machine: http://10.0.2.2:3000
# For Production deployment: https://your-vexorax-backend.run.app
VITE_API_BASE_URL=

# Android Release Signing Variables (Used by Gradle during ./gradlew assembleRelease):
# (Store your actual secrets securely in your CI/CD secrets manager, never commit .jks/.keystore files)
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
