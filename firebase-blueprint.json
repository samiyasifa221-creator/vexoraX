{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile details for a registered user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name",
          "maxLength": 60
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar URL"
        },
        "online": {
          "type": "boolean",
          "description": "Current presence status"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last presence ping"
        }
      },
      "required": ["userId", "displayName"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user details accessible only to the owner",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Registered email"
        },
        "pointsBalance": {
          "type": "number",
          "description": "Server-authoritative verified points balance. Direct client mutation prohibited."
        },
        "coinsBalance": {
          "type": "number",
          "description": "Server-authoritative coins balance. Direct client mutation prohibited."
        },
        "isPremium": {
          "type": "boolean",
          "description": "Premium subscriber status"
        },
        "riskScore": {
          "type": "number",
          "description": "Anti-fraud risk score (0-100)"
        },
        "isSuspended": {
          "type": "boolean",
          "description": "Account suspension flag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation time"
        }
      },
      "required": ["email", "pointsBalance", "createdAt"]
    },
    "TaskSession": {
      "title": "TaskSession",
      "description": "Short-lived server-issued task verification session",
      "type": "object",
      "properties": {
        "taskSessionId": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "taskId": {
          "type": "string",
          "description": "Task identifier"
        },
        "deviceId": {
          "type": "string",
          "description": "Android device identifier"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Start timestamp"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiry timestamp"
        },
        "status": {
          "type": "string",
          "enum": ["IN_PROGRESS", "COMPLETED", "EXPIRED", "REJECTED", "REVOKED"],
          "description": "Session state"
        },
        "verificationToken": {
          "type": "string",
          "description": "Cryptographic HMAC token generated by server"
        }
      },
      "required": ["taskSessionId", "userId", "taskId", "deviceId", "startedAt", "expiresAt", "status", "verificationToken"]
    },
    "PointsTransaction": {
      "title": "PointsTransaction",
      "description": "Immutable ledger record of points credited or debited",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "user_id": {
          "type": "string",
          "description": "Owner UID"
        },
        "task_session_id": {
          "type": "string",
          "description": "Associated task session"
        },
        "type": {
          "type": "string",
          "enum": ["TASK_REWARD", "CAMPAIGN_BONUS", "REFERRAL_REWARD", "ADMIN_REVERSAL", "ADMIN_ADJUSTMENT"],
          "description": "Transaction category"
        },
        "amount": {
          "type": "number",
          "description": "Points delta"
        },
        "balance_before": {
          "type": "number",
          "description": "Ledger balance prior to transaction"
        },
        "balance_after": {
          "type": "number",
          "description": "Ledger balance after transaction"
        },
        "idempotency_key": {
          "type": "string",
          "description": "Idempotency key guaranteeing exactly-once reward delivery"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction server timestamp"
        }
      },
      "required": ["id", "user_id", "type", "amount", "balance_before", "balance_after", "idempotency_key", "created_at"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Brand advertising and reward campaign",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "description": "Campaign identifier"
        },
        "title": {
          "type": "string",
          "description": "Campaign title"
        },
        "rewardAmount": {
          "type": "number",
          "description": "Reward per completion"
        },
        "totalBudget": {
          "type": "number",
          "description": "Campaign cost / budget allocated"
        },
        "remainingBudget": {
          "type": "number",
          "description": "Remaining budget"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "PAUSED", "COMPLETED"],
          "description": "Campaign status"
        }
      },
      "required": ["campaignId", "title", "rewardAmount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}/public/profile": {
      "schema": { "$ref": "UserProfile" },
      "description": "Public profile accessible to authorized users"
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "UserPrivate" },
      "description": "Private sensitive data accessible only to owner. Client writes prohibited for points, coins, premium, risk."
    },
    "/points_transactions/{transactionId}": {
      "schema": { "$ref": "PointsTransaction" },
      "description": "Immutable ledger. Read-only for owner; direct client writes strictly forbidden."
    },
    "/task_sessions/{sessionId}": {
      "schema": { "$ref": "TaskSession" },
      "description": "Short-lived task verification sessions managed solely by trusted backend"
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "Campaign" },
      "description": "Campaign catalogs readable by authenticated users; client modifications forbidden"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Authoritative admin lookup collection used for RBAC"
    }
  }
}
